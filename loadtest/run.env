# Change a value and push to start a load test (the run takes about 25 minutes).
# SIZE: current (as it is now), small (normal), big (boosted for the run, then back to automatic).
SIZE=small
MINUTES=15
# About 20,000 scans in 15 minutes: peak 28 a second.
GATE_TOTAL=20000
GATE_PEAK=28
# The on-sale rush: 25 tries a second for 3 minutes at 1,000 tickets.
BUY_RATE=25
BUY_MINUTES=3
RUSH_TICKETS=1000
SHARE_RATE=2
BROWSE_RATE=15
USERS=2000
RUN=1
