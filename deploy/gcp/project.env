# Google Cloud project for the GatePass API (written from deploy/gcp/setup.sh's output).
# GCP_* lines are for the deploy workflow; every other line becomes an API env var.
GCP_PROJECT_ID=gatepass-226471
GCP_PROJECT_NUMBER=343694280392
GCP_REGION=asia-south1
GCP_WIF_PROVIDER=projects/343694280392/locations/global/workloadIdentityPools/github/providers/github

# Test server: no SMS, payments are pretend. Only TEST_PHONES sign in, with the shared test code (Secret Manager: TEST_OTP);
# admins, organisers and distributors get their own code (Organiser app › Test Sign-in Codes).
# TEST_PHONES=8460893696,9376509376,8733031815,8734931815 would let any number sign in (owner's call, docs/09 #18); off for now.
# For launch: TEST_MODE=false, SMS_PROVIDER=msg91, PAYMENT_GATEWAY=razorpay (+ their secrets).
TEST_MODE=true
TEST_PHONES=8460893696,9376509376,8733031815,8734931815
BOOTSTRAP_ADMINS=8460893696
# Roles given on boot (only ever added): organiser, staff, seller (B2B seller of the first admin), distributor.
BOOTSTRAP_ROLES=8733031815:organiser,8734931815:seller
SMS_PROVIDER=console
PAYMENT_GATEWAY=mock
WHATSAPP_PROVIDER=none
