# Google Cloud project for the GatePass API (written from deploy/gcp/setup.sh's output).
# GCP_* lines are for the deploy workflow; every other line becomes an API env var.
GCP_PROJECT_ID=gatepass-226471
GCP_PROJECT_NUMBER=343694280392
GCP_REGION=asia-south1
GCP_WIF_PROVIDER=projects/343694280392/locations/global/workloadIdentityPools/github/providers/github

# Test server: only invited numbers sign in (code in Secret Manager: TEST_OTP), payments are pretend.
# For launch: TEST_MODE=false, SMS_PROVIDER=msg91, PAYMENT_GATEWAY=razorpay (+ their secrets).
TEST_MODE=true
TEST_PHONES=8460893696
BOOTSTRAP_ADMINS=8460893696
SMS_PROVIDER=console
PAYMENT_GATEWAY=mock
WHATSAPP_PROVIDER=none
