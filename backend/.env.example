# GatePass API configuration. Copy to .env for local development.
# In production (NODE_ENV=production) the server refuses to start if a secret
# is missing/weak, SMS_PROVIDER=console, or PAYMENT_GATEWAY=mock.

NODE_ENV=development
PORT=4000
# Public URL of this API (used for signed invoice links). Trailing slash.
PUBLIC_BASE_URL=http://localhost:4000/

# --- data stores ---
DATABASE_URL=postgres://postgres:eventa@localhost:5433/eventa
DATABASE_SSL=false
DB_MIGRATE_ON_BOOT=true
# Dev/staging only: insert demo cities/events on first boot.
SEED_ON_BOOT=true
# Required in production (OTP codes + rate limits shared across instances).
# REDIS_URL=redis://localhost:6379

# --- secrets: generate each with `openssl rand -base64 48` (min 32 chars) ---
# Unset in development = random per process (sessions reset on restart).
JWT_SECRET=
# Ed25519 key that signs ticket QR codes (gates verify offline with the public
# key). Generate with `npm run keys:ticket`. Rotating it invalidates issued QRs.
TICKET_SIGNING_KEY=
URL_SIGNING_SECRET=
OTP_PEPPER=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=15552000

# --- SMS (OTP delivery): console | msg91 | twilio ---
SMS_PROVIDER=console
# Dev only, console provider only: fixed code instead of a random one.
DEV_OTP=123456
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=        # DLT-approved template containing ##otp##
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# --- Closed testing on a real server (before SMS + Razorpay accounts exist) ---
# TEST_MODE=true allows SMS_PROVIDER=console + DEV_OTP + PAYMENT_GATEWAY=mock in
# production, but ONLY the numbers in TEST_PHONES can sign in. Off for launch.
# TEST_MODE=false
# TEST_PHONES=9876543210,9123456780
# Numbers made admin + distributor on boot (no shell needed on Cloud Run):
# BOOTSTRAP_ADMINS=9876543210

# --- WhatsApp ticket messages (Meta WhatsApp Cloud API; docs/16) ---
WHATSAPP_PROVIDER=none          # meta | log | none
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_RECEIVED=ticket_received
# WHATSAPP_TEMPLATE_WAITING=ticket_waiting
# WHATSAPP_TEMPLATE_LANGUAGE=en

# --- payments: mock | razorpay | youpi ---
PAYMENT_GATEWAY=mock            # mock | razorpay | youpi (docs/15)
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# B2B: sellers pay the main distributor's OWN Razorpay account (no UTR; docs/17).
# Webhook on that account: <PUBLIC_BASE_URL>api/payment/razorpay/b2b-webhook
# RAZORPAY_B2B_KEY_ID=rzp_live_xxx
# RAZORPAY_B2B_KEY_SECRET=
# RAZORPAY_B2B_WEBHOOK_SECRET=
# RAZORPAY_B2B_DISTRIBUTOR_PHONE=   # the distributor's GatePass number

# YouPI (self-hosted UPI gateway, github.com/youpi-pg/youpi-pg) — customer checkout.
# Webhook URL to set on YouPI: <PUBLIC_BASE_URL>api/payment/youpi/webhook
# YOUPI_API_URL=https://pay.yourdomain.com/
# YOUPI_MERCHANT_ID=
# YOUPI_MERCHANT_API_KEY=
# YOUPI_WEBHOOK_SECRET=
# YOUPI_ACCEPT=observed            # observed (bank alert seen, seconds) | reconciled (statement match, slow)
# YOUPI_RETURN_URL=                # default <PUBLIC_BASE_URL>pay/done (allowlist its origin on YouPI)

# YouPI for B2B: the main distributor's own UPI, so seller payments confirm themselves.
# YOUPI_B2B_API_URL=https://pay.yourdomain.com/
# YOUPI_B2B_MERCHANT_ID=
# YOUPI_B2B_MERCHANT_API_KEY=
# YOUPI_B2B_WEBHOOK_SECRET=
# YOUPI_B2B_DISTRIBUTOR_PHONE=     # the distributor's GatePass number
# ALLOW_TEST_PAYMENTS=false   # staging with NODE_ENV=production + test keys
# Booking fee: the STARTING default only. Admins change it any time in the Organiser app
# (Events › Booking Fees; per event in Event Terms). Percentage, or paise per ticket (FEE_TYPE=fixed_per_ticket).
# Events can override with their own fee.
FEE_TYPE=percentage
FEE_PCT=3
GST_PCT=18
# fee = GST on the booking fee only (legacy app); fee_and_tickets = on everything
GST_ON=fee
GST_INCLUDED=false
# Your GST registration state: buyers in the same state pay CGST+SGST, others IGST
ORGANIZER_STATE=Maharashtra
# Coins credited on each confirmed booking, % of ticket value (0 = off)
COINS_CASHBACK_PCT=0
BOOKING_HOLD_SECONDS=600
SEAT_HOLD_SECONDS=600         # seat hold before checkout (booking/seat-reserve)
UPLOAD_DIR=uploads             # registration-form uploads (mount a volume in production)

# --- invoices ---
INVOICE_SELLER_NAME=Your Company Pvt Ltd
INVOICE_SELLER_ADDRESS=
INVOICE_GSTIN=

# --- HTTP ---
# Comma-separated browser origins allowed by CORS (mobile apps need none).
CORS_ORIGINS=
TRUST_PROXY=false
ENABLE_SWAGGER=true
# Per signed-in account (writes / reads a minute)
RATE_LIMIT_MUTATING_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=300
# Per IP for anonymous callers (higher: venue Wi-Fi and mobile carriers share IPs)
RATE_LIMIT_ANON_MUTATING_PER_MIN=300
RATE_LIMIT_ANON_READ_PER_MIN=1200
# Login codes per IP per 10 minutes (each phone is separately capped at 3)
OTP_PER_IP_PER_10MIN=60

# Shared key/value (codes, counters): REDIS_URL, or KV_DRIVER=postgres to keep it in the database
# KV_DRIVER=postgres
# Postgres connections per API instance (instances × this must stay under the database limit)
DB_POOL_MAX=10
# Background jobs: timers (default) or http (a scheduler POSTs api/internal/jobs/tick with x-jobs-secret)
# JOBS_MODE=http
# JOBS_SECRET=
# Form uploads: local (UPLOAD_DIR) or gcs (GCS_BUCKET, uses the runtime service account)
# STORAGE_DRIVER=gcs
# GCS_BUCKET=

# --- app update / maintenance (GET api/app-config) ---
APP_ANDROID_LATEST=0.1.0
APP_ANDROID_MIN=0.0.0
APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.gatepass.app
APP_IOS_LATEST=0.1.0
APP_IOS_MIN=0.0.0
APP_IOS_STORE_URL=https://apps.apple.com/
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are making things better. Back shortly!

# Push notifications (optional): Firebase service-account JSON, raw or base64. Without it push is off.
FCM_SERVICE_ACCOUNT=
# PUSH_INTERVAL_MS=5000
