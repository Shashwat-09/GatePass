# Copy to .env and fill. In dev the store is in-memory; DB vars are for the
# production swap to Postgres (see docs/04 + schema.sql).
PORT=4000
JWT_SECRET=change-me-dev-secret
JWT_REFRESH_SECRET=change-me-dev-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Dev OTP: any phone accepts this code (matches the Flutter app's demo code).
DEV_OTP=123456

# --- production (not used by the in-memory dev store) ---
# DATABASE_URL=postgres://user:pass@localhost:5432/eventa
# REDIS_URL=redis://localhost:6379
# PAYMENT_GATEWAY_KEY=
# PAYMENT_GATEWAY_SECRET=
# PAYMENT_WEBHOOK_SECRET=
